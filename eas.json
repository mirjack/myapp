{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_BASE_URL": "https://stg-api.cmfrt.uz",
        "EXPO_PUBLIC_STOREFRONT_DOMAIN": "mirjeck.cmfrt.uz",
        "EXPO_PUBLIC_TENANT_DOMAIN": "mirjeck.cmfrt.uz",
        "EXPO_PUBLIC_YANDEX_MAPS_API_KEY": "b82151fe-a079-4e62-8392-b4cd2c014088"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "https://stg-api.cmfrt.uz",
        "EXPO_PUBLIC_STOREFRONT_DOMAIN": "mirjeck.cmfrt.uz",
        "EXPO_PUBLIC_TENANT_DOMAIN": "mirjeck.cmfrt.uz",
        "EXPO_PUBLIC_YANDEX_MAPS_API_KEY": "b82151fe-a079-4e62-8392-b4cd2c014088"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.cmfrt.uz",
        "EXPO_PUBLIC_STOREFRONT_DOMAIN": "mirjeck.cmfrt.uz",
        "EXPO_PUBLIC_TENANT_DOMAIN": "mirjeck.cmfrt.uz",
        "EXPO_PUBLIC_YANDEX_MAPS_API_KEY": "b82151fe-a079-4e62-8392-b4cd2c014088"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
