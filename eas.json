{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_BASE_URL": "https://stg-api.cmfrt.uz",
        "EXPO_PUBLIC_STOREFRONT_DOMAIN": "mirjeck.cmfrt.uz",
        "EXPO_PUBLIC_TENANT_DOMAIN": "mirjeck.cmfrt.uz",
        "EXPO_PUBLIC_YANDEX_MAPS_API_KEY": "14cb49b1-4a7a-4b6e-9116-bcc9dc29e015"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "https://stg-api.cmfrt.uz",
        "EXPO_PUBLIC_STOREFRONT_DOMAIN": "mirjeck.cmfrt.uz",
        "EXPO_PUBLIC_TENANT_DOMAIN": "mirjeck.cmfrt.uz",
        "EXPO_PUBLIC_YANDEX_MAPS_API_KEY": "14cb49b1-4a7a-4b6e-9116-bcc9dc29e015",
        "ANDROID_BUILD_ARCHS": "armeabi-v7a,arm64-v8a"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.cmfrt.uz",
        "EXPO_PUBLIC_STOREFRONT_DOMAIN": "mirjeck.cmfrt.uz",
        "EXPO_PUBLIC_TENANT_DOMAIN": "mirjeck.cmfrt.uz",
        "EXPO_PUBLIC_YANDEX_MAPS_API_KEY": "14cb49b1-4a7a-4b6e-9116-bcc9dc29e015"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview-arm64": {
      "extends": "preview",
      "env": {
        "ANDROID_BUILD_ARCHS": "arm64-v8a"
      }
    },
    "preview-universal": {
      "extends": "preview",
      "env": {
        "ANDROID_BUILD_ARCHS": "armeabi-v7a,arm64-v8a,x86,x86_64"
      }
    }
  }
}
